---
import '../styles/global.css';
import { getLang, localizePath, useT } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { title = t('meta.title'), description = t('meta.description') } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = (['es', 'en'] as const).map((l) => ({ lang: l, href: new URL(localizePath(Astro.url.pathname, l), Astro.site) }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <!-- Tema antes de pintar: la preferencia guardada o, si no hay, la del sistema. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('chuspa-theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#fafafa' : '#0a0a0a');
      })();
    </script>
  </head>
  <body class="min-h-dvh font-sans text-zinc-100 antialiased selection:bg-salsa-orange selection:text-white">
    <a
      href="#contenido"
      class="sr-only z-50 rounded-lg bg-salsa-orange px-4 py-2 font-bold text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >{t('skip')}</a
    >
    <slot />
  </body>
</html>
