---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'openchuspa.xyz | El Motor Caleño de S3',
  description = 'OpenChuspa: el motor caleño de almacenamiento de objetos compatible con AWS S3.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh font-sans text-zinc-100 antialiased selection:bg-salsa-orange selection:text-white">
    <slot />
  </body>
</html>
