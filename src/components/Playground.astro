---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { CLI_VERSION, PROMPT, REGION } from '../data/constants';
import { quickCommands } from '../data/site';
---

<section id="playground" class="py-16 sm:py-24">
  <div class="container-page">
    <SectionHeader
      eyebrow="Consola Interactiva chuspa-cli"
      title="Probá el CLI Caleño en Vivo"
      description="Escribí tus comandos con la jerga caleña real y mirá cómo responde el motor de almacenamiento."
    />

    <div class="overflow-hidden rounded-xl border border-salsa-border bg-salsa-dark">
      <!-- Barra de título -->
      <div class="flex items-center justify-between gap-3 border-b border-salsa-border bg-black/40 px-4 py-3 sm:px-6 sm:py-4">
        <div class="flex min-w-0 items-center gap-2">
          <span class="size-3 shrink-0 rounded-full bg-red-500/80"></span>
          <span class="size-3 shrink-0 rounded-full bg-yellow-500/80"></span>
          <span class="size-3 shrink-0 rounded-full bg-green-500/80"></span>
          <span class="ml-2 truncate font-mono text-xs text-muted sm:ml-4"
            >caleño-terminal@openchuspa:~ (chuspa-cli {CLI_VERSION})</span
          >
        </div>
        <span
          class="hidden shrink-0 rounded-md border border-salsa-border bg-white/5 px-2.5 py-1 font-mono text-[11px] text-muted md:block"
          >Motor: S3 Core Caleño</span
        >
      </div>

      <!-- Atajos -->
      <div class="flex flex-wrap items-center gap-2 border-b border-salsa-border bg-salsa-card px-4 py-3 font-mono text-xs sm:px-6">
        <span class="w-full text-muted sm:w-auto">Atajos de comando:</span>
        {
          quickCommands.map((q, i) => (
            <button
              type="button"
              data-cmd={q.cmd}
              class="js-run-cmd max-w-full truncate rounded-lg border border-salsa-border bg-salsa-dark px-3 py-2 text-muted transition-colors hover:border-salsa-orange hover:bg-salsa-orange/10 hover:text-salsa-orange"
            >
              {i + 1}. {q.label}
            </button>
          ))
        }
      </div>

      <div class="grid lg:min-h-[420px] lg:grid-cols-12">
        <!-- Terminal -->
        <div
          class="flex min-w-0 flex-col justify-between border-b border-salsa-border p-4 font-mono text-xs sm:p-6 sm:text-sm lg:col-span-7 lg:border-r lg:border-b-0"
        >
          <div
            id="terminal-screen"
            role="log"
            aria-live="polite"
            aria-label="Salida de la terminal"
            tabindex="0"
            class="h-64 cursor-text space-y-3 overflow-y-auto pr-2 break-words sm:h-80 lg:h-[360px]"
          >
            <p class="text-muted">
              OpenChuspa CLI {CLI_VERSION} (compatible con AWS CLI)<br />
              Escribí <span class="text-salsa-orange">'ayuda'</span> o probá comandos como
              <span class="text-ink">'ve mira'</span>, <span class="text-ink">'ve subi'</span>,
              <span class="text-ink">'ve baja'</span>. Con ↑ y ↓ recorrés el historial.
            </p>
          </div>

          <form
            id="terminal-form"
            class="mt-4 flex items-center gap-2 rounded-xl border border-salsa-border bg-salsa-card/80 p-2 focus-within:border-salsa-orange"
          >
            <label for="terminal-input" class="shrink-0 font-bold text-muted">
              <span class="hidden md:inline">{PROMPT}</span>
              <span class="pl-1 md:hidden" aria-hidden="true">$</span>
              <span class="sr-only md:hidden">Comando</span>
            </label>
            <!-- 16px en móvil: evita el zoom automático de iOS al enfocar -->
            <input
              type="text"
              id="terminal-input"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              enterkeyhint="send"
              placeholder="ve mira chuspa://"
              class="min-w-0 flex-1 bg-transparent font-mono text-base text-ink placeholder:text-muted focus:outline-none sm:text-sm"
            />
            <button type="submit" class="btn-primary shrink-0 rounded-lg px-3 py-2 text-xs sm:px-4">Ejecutar</button>
          </form>
        </div>

        <!-- Estado de las chuspas -->
        <div class="flex min-w-0 flex-col justify-between bg-salsa-dark/50 p-4 sm:p-6 lg:col-span-5">
          <div>
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
              <span class="flex items-center gap-2 font-mono text-xs font-bold tracking-wider text-muted uppercase">
                <Icon name="FolderTree" class="size-4" />
                <span>Estado en Vivo de tus Chuspas</span>
              </span>
              <span id="bucket-count" class="rounded bg-salsa-orange/20 px-2 py-0.5 font-mono text-[11px] text-salsa-orange"></span>
            </div>
            <div id="buckets-tree" class="space-y-3 font-mono text-xs"></div>
          </div>

          <div class="mt-6 border-t border-salsa-border pt-4">
            <span class="mb-1 block font-mono text-[11px] text-muted">Sucursal del Cielo (Región actual):</span>
            <div class="flex items-center gap-2 font-mono text-xs text-muted">
              <Icon name="MapPin" class="size-4" />
              <span>{REGION} (Latencia: 0.3ms)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { PROMPT, REGION } from '../data/constants';

  // ====== Estado simulado (todo vive en memoria del navegador) ======
  const chuspas = new Map<string, string[]>([
    ['prod-chuspa-name', ['test/file.txt', 'music/cancion.mp3', 'fotos/cali.jpg']],
    ['backup-chuspa', ['database_dump.sql.gz']],
  ]);

  const TONES = {
    plain: '',
    brand: 'text-salsa-orange',
    bright: 'text-zinc-100',
    muted: 'text-zinc-400',
    error: 'text-red-400',
  };
  type Segment = string | [text: string, tone: keyof typeof TONES, bold?: boolean];

  // Todo el texto entra por textContent: lo que escribe el usuario nunca se interpreta como HTML.
  function el(tag: string, className = '', ...children: (Node | string)[]) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    node.append(...children);
    return node;
  }

  function line(...segments: Segment[]) {
    return el(
      'div',
      '',
      ...segments.map((s) =>
        typeof s === 'string' ? s : el('span', `${TONES[s[1]]} ${s[2] ? 'font-bold' : ''}`.trim(), s[0])
      )
    );
  }

  const screen = document.getElementById('terminal-screen');
  const tree = document.getElementById('buckets-tree');
  const count = document.getElementById('bucket-count');

  function renderChuspas() {
    if (!tree) return;
    if (count) count.textContent = `${chuspas.size} Chuspas`;

    tree.replaceChildren(
      ...[...chuspas].map(([name, files]) =>
        el(
          'div',
          'rounded-xl border border-salsa-border bg-salsa-card p-3',
          el(
            'div',
            'mb-1 flex items-center justify-between gap-2 font-bold text-salsa-orange',
            el('span', 'min-w-0 truncate', `chuspa://${name}`),
            el('span', 'shrink-0 text-[10px] font-normal text-zinc-500', `(${files.length} chucherías)`)
          ),
          ...(files.length
            ? files.map((f) =>
                el(
                  'div',
                  'flex items-center justify-between gap-2 py-0.5 pl-4 text-[11px] text-zinc-400',
                  el('span', 'min-w-0 truncate', f),
                  el('span', 'shrink-0 text-[10px] text-zinc-300', 'OK')
                )
              )
            : [el('div', 'pl-4 text-[11px] text-zinc-600', 'Chuspa vacía')])
        )
      )
    );
  }

  const HELP: [cmd: string, description: string][] = [
    ['ve mira chuspa://', 'Listar chuspas o contenido'],
    ['ve crea chuspa://nombre', 'Crear nueva chuspa'],
    ['ve subi ./file a chuspa://nombre/path/', 'Subir archivo'],
    ['ve baja chuspa://nombre/path/file .', 'Descargar archivo'],
    ['ve borra chuspa://nombre/path/file', 'Eliminar archivo'],
    ['ve sincroniza ./carpeta chuspa://nombre/', 'Sincronizar carpeta'],
    ['limpiar', 'Limpiar la pantalla'],
  ];

  function respond(cmd: string): HTMLElement[] {
    if (cmd === 'ayuda') {
      return [
        line(['Comandos Caleños disponibles:', 'brand', true]),
        ...HELP.map(([c, d]) => line('• ', [c, 'bright'], ` : ${d}`)),
      ];
    }

    if (cmd.startsWith('ve mira')) {
      const target = cmd.split(/\s+/)[2] || 'chuspa://';
      if (target === 'chuspa://') {
        return [line(['Listando Chuspas Caleñas:', 'muted']), ...[...chuspas.keys()].map((k) => line(`chuspa://${k}/`))];
      }
      const name = target.replace('chuspa://', '').split('/')[0];
      const files = chuspas.get(name);
      if (!files) {
        return [line([`¡Oíste! La chuspa '${name}' no existe aún. Creala con 've crea chuspa://${name}'`, 'error'])];
      }
      return [
        line([`Contenido de chuspa://${name}:`, 'muted']),
        ...(files.length ? files.map((f) => line(`  ${f}`)) : [line('  (Chuspa vacía)')]),
      ];
    }

    if (cmd.startsWith('ve crea')) {
      const name = (cmd.split(/\s+/)[2] || '').replace('chuspa://', '').replaceAll('/', '');
      if (!name) return [line(['Sintaxis: ve crea chuspa://nombre-de-chuspa', 'error'])];
      if (chuspas.has(name)) return [line([`Esa chuspa '${name}' ya existe en el parqueo.`, 'brand'])];
      chuspas.set(name, []);
      renderChuspas();
      return [
        line(['¡Chuspa creada con éxito!', 'bright']),
        line(`HTTP 200 OK — s3://${name} lista en '${REGION}'. ¡Vos sabés!`),
      ];
    }

    if (cmd.startsWith('ve subi')) {
      const match = cmd.match(/^ve subi (.+) a chuspa:\/\/([^/]+)\/?(.*)$/);
      if (!match) return [line(['Uso correcto: ve subi ./archivo.txt a chuspa://nombre-chuspa/ruta/', 'brand'])];
      const localFile = match[1].replace('./', '');
      const [, , name, path = ''] = match;
      const key = path ? (path.endsWith('/') ? path + localFile : path) : localFile;

      chuspas.set(name, [key, ...(chuspas.get(name) ?? []).filter((k) => k !== key)]);
      renderChuspas();
      return [
        line(['¡Empacado en Chuspa exitoso!', 'bright', true]),
        line('Local: ', [localFile, 'bright'], ' -> Remote: ', [`chuspa://${name}/${key}`, 'muted']),
        line('Velocidad: 820 MB/s • Sello Caleño S3: VÁLIDO'),
      ];
    }

    if (cmd.startsWith('ve baja')) {
      return [
        line(['Sacando de la chuspa...', 'muted', true]),
        line('Descargado en tu directorio local. ¡Todo bien, todo bonito!'),
      ];
    }

    if (cmd.startsWith('ve sincroniza')) {
      return [
        line(['Sincronizando con la chuspa...', 'muted', true]),
        line('Carpeta al día: local y remoto quedaron igualitos. ¡Qué chimba!'),
      ];
    }

    if (cmd.startsWith('ve borra')) {
      return [line(['Objeto borrado de la chuspa. ¡Limpieza caleña efectuada!', 'error'])];
    }

    return [line(['Comando no reconocido. Escribí ', 'muted'], ["'ayuda'", 'brand', true], [' para ver la guía de la chuspa.', 'muted'])];
  }

  function runCommand(cmd: string) {
    if (!screen) return;
    if (cmd === 'limpiar') {
      screen.replaceChildren();
      return;
    }
    screen.append(
      el('div', 'mt-3 font-bold text-white', el('span', 'text-zinc-400', `${PROMPT} `), cmd),
      el('div', 'my-1 space-y-0.5 border-l-2 border-salsa-orange pl-4 whitespace-pre-wrap text-zinc-300', ...respond(cmd))
    );
    screen.scrollTop = screen.scrollHeight;
  }

  renderChuspas();

  const input = document.getElementById('terminal-input') as HTMLInputElement | null;
  const history: string[] = [];
  let cursor = 0;

  document.getElementById('terminal-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const cmd = input?.value.trim();
    if (!cmd || !input) return;
    runCommand(cmd);
    history.push(cmd);
    cursor = history.length;
    input.value = '';
  });

  // Flechas arriba/abajo recorren el historial, como en una terminal de verdad
  input?.addEventListener('keydown', (e) => {
    const step = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
    if (!step || !history.length) return;
    e.preventDefault();
    cursor = Math.min(Math.max(cursor + step, 0), history.length);
    input.value = history[cursor] ?? '';
  });

  // Clic en la pantalla = escribir (salvo que se esté seleccionando texto)
  screen?.addEventListener('click', () => {
    if (!window.getSelection()?.toString()) input?.focus({ preventScroll: true });
  });

  // Atajos de la terminal y botones "Probar" del resto de la página
  document.querySelectorAll<HTMLElement>('.js-run-cmd').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!btn.dataset.cmd) return;
      runCommand(btn.dataset.cmd);
      if (!btn.closest('#playground')) screen?.scrollIntoView({ block: 'center' });
    });
  });
</script>
