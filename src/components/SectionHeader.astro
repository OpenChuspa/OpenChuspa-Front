---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="mt-4 mb-4 text-3xl font-black text-balance sm:text-4xl lg:text-5xl">{title}</h2>
  <p class="text-base text-pretty text-muted sm:text-lg">{description}</p>
</div>
