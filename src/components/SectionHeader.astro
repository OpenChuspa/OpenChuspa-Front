---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-12 max-w-2xl sm:mb-16">
  <p class="eyebrow">
    <span class="inline-block size-1.5 rounded-full bg-salsa-orange"></span>
    {eyebrow}
  </p>
  <h2 class="display-serif mt-4 text-3xl text-balance sm:text-4xl">{title}</h2>
  <p class="mt-3 text-base text-pretty text-muted sm:text-lg">{description}</p>
</div>
