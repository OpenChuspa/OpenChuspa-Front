---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { sdkSnippets } from '../data/site';
---

<section id="sdks" class="py-16 sm:py-24">
  <div class="container-page">
    <SectionHeader
      eyebrow="Compatibilidad Total"
      title="Integración con SDKs S3"
      description="Usá tus librerías de programación favoritas configurando el Endpoint de OpenChuspa."
    />

    <div class="overflow-hidden rounded-xl border border-salsa-border bg-salsa-card">
      <!-- En móvil las pestañas se desplazan en horizontal en lugar de apilarse -->
      <div
        role="tablist"
        aria-label="Lenguaje o herramienta"
        class="flex gap-2 overflow-x-auto border-b border-salsa-border bg-salsa-dark p-3 sm:flex-wrap"
      >
        {
          sdkSnippets.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.key}`}
              aria-controls={`panel-${s.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-title={s.title}
              class="sdk-tab shrink-0 rounded-lg bg-salsa-card px-4 py-2.5 font-mono text-xs font-bold whitespace-nowrap text-muted transition-colors hover:bg-salsa-border aria-selected:bg-salsa-orange aria-selected:text-white sm:px-5"
            >
              {s.tab}
            </button>
          ))
        }
      </div>

      <div class="bg-salsa-dark p-4 font-mono text-xs sm:p-6 sm:text-sm">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <span id="sdk-title" class="min-w-0 font-bold text-muted">{sdkSnippets[0].title}</span>
          <button
            type="button"
            data-copy-target="#sdks [role=tabpanel]:not([hidden]) code"
            class="flex shrink-0 items-center gap-1.5 rounded-lg bg-salsa-border px-3 py-2 text-xs font-bold text-muted transition-colors hover:bg-salsa-orange hover:text-white"
          >
            <Icon name="Copy" class="size-3.5" />
            <span>Copiar Código</span>
          </button>
        </div>

        {
          sdkSnippets.map((s, i) => (
            <pre
              role="tabpanel"
              id={`panel-${s.key}`}
              aria-labelledby={`tab-${s.key}`}
              tabindex="0"
              hidden={i !== 0}
              class="overflow-x-auto rounded-lg border border-salsa-border bg-black/50 p-4 leading-relaxed text-muted sm:p-5"
            ><code>{s.code}</code></pre>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLElement>('.sdk-tab')];
  const title = document.getElementById('sdk-title');

  function select(tab: HTMLElement, focus = false) {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !active;
    }
    if (title) title.textContent = tab.dataset.title ?? '';
    if (focus) {
      tab.focus();
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      select(tabs[(i + step + tabs.length) % tabs.length], true);
    });
  });
</script>
