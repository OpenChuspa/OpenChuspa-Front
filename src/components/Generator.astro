---
import Icon from './Icon.astro';
import { DEFAULT_CHUSPA } from '../data/constants';
import { siteData } from '../data/site';
import { getLang, useT } from '../i18n/ui';
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { generatorActions } = siteData(lang);

const field =
  'w-full rounded-xl border border-salsa-border bg-salsa-dark p-3 text-base text-white transition-colors hover:border-zinc-600 focus:border-salsa-orange focus:outline-none sm:text-sm';
---

<section id="generador" class="py-16 sm:py-24">
  <div class="container-page">
    <div class="rounded-2xl border-2 border-salsa-border bg-salsa-card p-5 shadow-2xl sm:rounded-3xl sm:p-8 lg:p-12">
      <div class="grid items-center gap-8 lg:grid-cols-2">
        <div class="min-w-0 space-y-6">
          <div>
            <span class="font-mono text-xs font-bold tracking-wider text-salsa-orange uppercase"
              >{t('gen.eyebrow')}</span
            >
            <h2 class="mt-1 text-2xl font-black text-balance text-white sm:text-3xl">{t('gen.title')}</h2>
            <p class="mt-2 text-sm text-zinc-400">{t('gen.description')}</p>
          </div>

          <div class="space-y-4 font-mono text-xs">
            <div>
              <label for="gen-action" class="mb-1 block text-zinc-300">{t('gen.action')}</label>
              <select id="gen-action" class={field}>
                {generatorActions.map((a) => <option value={a.value}>{a.label}</option>)}
              </select>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="gen-file" class="mb-1 block text-zinc-300">{t('gen.file')}</label>
                <input type="text" id="gen-file" value="./documento_impreso.pdf" autocomplete="off" spellcheck="false" class={field} />
              </div>
              <div>
                <label for="gen-chuspa" class="mb-1 block text-zinc-300">{t('gen.chuspa')}</label>
                <input type="text" id="gen-chuspa" value={DEFAULT_CHUSPA} autocomplete="off" spellcheck="false" class={field} />
              </div>
            </div>
          </div>
        </div>

        <div class="min-w-0 rounded-2xl border border-salsa-border bg-salsa-dark p-4 font-mono sm:p-6">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-bold text-zinc-300">{t('gen.result')}</span>
            <button type="button" data-copy-target="#gen-output" class="btn-primary rounded-lg px-3 py-2 text-xs">
              <Icon name="Copy" class="size-3.5" />
              <span>{t('copy')}</span>
            </button>
          </div>
          <output
            id="gen-output"
            for="gen-action gen-file gen-chuspa"
            class="block rounded-xl border border-salsa-border bg-salsa-card p-4 text-sm leading-relaxed font-bold break-all text-salsa-orange"
          ></output>
          <p class="mt-4 text-[11px] break-all text-zinc-500">
            {t('gen.aws')} <span id="gen-aws-equiv" class="text-zinc-400"></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { DEFAULT_CHUSPA, ENDPOINT } from '../data/constants';

  const action = document.getElementById('gen-action') as HTMLSelectElement | null;
  const file = document.getElementById('gen-file') as HTMLInputElement | null;
  const chuspa = document.getElementById('gen-chuspa') as HTMLInputElement | null;
  const out = document.getElementById('gen-output');
  const equiv = document.getElementById('gen-aws-equiv');

  // Por acción: [comando caleño, equivalente de AWS CLI sin el --endpoint-url]
  const BUILDERS: Record<string, (file: string, chuspa: string) => [string, string]> = {
    subi: (f, c) => [`ve subi ${f} a chuspa://${c}/test/`, `aws s3 cp ${f} s3://${c}/test/`],
    baja: (f, c) => [`ve baja chuspa://${c}/test/${f.replace('./', '')} .`, `aws s3 cp s3://${c}/test/${f.replace('./', '')} .`],
    crea: (_, c) => [`ve crea chuspa://${c}`, `aws s3 mb s3://${c}`],
    mira: (_, c) => [`ve mira chuspa://${c}/`, `aws s3 ls s3://${c}/`],
    borra: (f, c) => [`ve borra chuspa://${c}/test/${f.replace('./', '')}`, `aws s3 rm s3://${c}/test/${f.replace('./', '')}`],
  };

  function generate() {
    if (!action || !file || !chuspa || !out || !equiv) return;
    const build = BUILDERS[action.value];
    if (!build) return;
    const [caleño, aws] = build(file.value.trim() || './archivo.txt', chuspa.value.trim() || DEFAULT_CHUSPA);
    out.textContent = caleño;
    equiv.textContent = `${aws} --endpoint-url ${ENDPOINT}`;
  }

  action?.addEventListener('change', generate);
  file?.addEventListener('input', generate);
  chuspa?.addEventListener('input', generate);
  generate();
</script>
