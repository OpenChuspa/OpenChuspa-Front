---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import elParchao from '../assets/el-parchao.webp';
import { siteData } from '../data/site';
import { CLI_VERSION } from '../data/constants';
import { getLang, localizePath, useT } from '../i18n/ui';
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { highlights } = siteData(lang);
---

<section class="relative overflow-hidden pt-[calc(var(--header-h)+2.5rem)] pb-16 sm:pb-20 lg:pt-[calc(var(--header-h)+5rem)] lg:pb-28">
  <!-- Resplandor de fondo (gradiente, sin filtros de blur costosos) -->
  <div
    class="pointer-events-none absolute top-1/4 left-1/2 aspect-square w-[min(900px,160vw)] -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(closest-side,rgb(255_107_0/0.16),transparent)]"
  >
  </div>

  <div class="container-page relative grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="text-center lg:col-span-7 lg:text-left">
      <p
        class="mb-6 inline-flex max-w-full items-center gap-2 rounded-2xl border border-salsa-orange/40 bg-salsa-card px-4 py-2 text-left sm:rounded-full"
      >
        <span class="size-2.5 shrink-0 animate-ping rounded-full bg-zinc-300"></span>
        <span class="text-[11px] font-bold tracking-wider text-salsa-orange uppercase sm:text-xs"
          >{t('hero.badge', { v: CLI_VERSION })}</span
        >
      </p>

      <h1 class="mb-6 text-[clamp(2rem,7vw+0.5rem,4.5rem)] leading-[1.1] font-extrabold tracking-tight text-balance">
        {t('hero.title1')} <span class="gradient-text-salsa">{t('hero.title2')}</span>.
      </h1>

      <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-pretty text-zinc-300 sm:text-xl lg:mx-0">
        {t('hero.lead')}{' '}
        <code class="font-mono text-[0.9em] font-bold break-words text-salsa-orange"
          >ve subi ./file.txt a chuspa://mi-parche/</code
        >{' '}{t('hero.leadEnd')}
      </p>

      <div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center sm:gap-4 lg:justify-start">
        <a href={localizePath('/docs/instalacion/', lang)} class="btn-primary rounded-2xl px-6 py-4 text-base sm:px-8">
          <Icon name="Download" class="size-5" />
          <span>{t('hero.install')}</span>
        </a>
        <a
          href={localizePath('/docs/', lang)}
          class="inline-flex items-center justify-center gap-2 rounded-2xl border border-salsa-border bg-salsa-card px-6 py-4 text-base font-semibold text-zinc-200 transition-colors hover:border-zinc-600 hover:bg-salsa-border sm:px-8"
        >
          <Icon name="BookOpen" class="size-5 text-zinc-400" />
          <span>{t('hero.docs')}</span>
        </a>
      </div>

      <dl
        class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-5 border-t border-salsa-border pt-8 text-left sm:gap-x-12 lg:justify-start"
      >
        {
          highlights.map((h) => (
            <div>
              <dt class="text-[11px] text-zinc-400 uppercase">{t(h.label)}</dt>
              <dd
                class:list={[
                  'text-lg font-black whitespace-nowrap sm:text-2xl',
                  h.accent ? 'text-salsa-orange' : 'text-zinc-200',
                ]}
              >
                {h.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="flex justify-center lg:col-span-5">
      <div class="relative w-full max-w-sm lg:max-w-md">
        <div class="absolute inset-0 animate-pulse-glow rounded-3xl bg-linear-to-tr from-salsa-orange to-zinc-400 opacity-40 blur-2xl">
        </div>
        <div class="relative flex flex-col items-center rounded-3xl border-2 border-salsa-border bg-salsa-card p-5 shadow-2xl sm:p-8">
          <Image
            src={elParchao}
            alt={t('hero.mascot')}
            widths={[320, 480, elParchao.width]}
            sizes="(min-width: 400px) 320px, 80vw"
            quality={88}
            loading="eager"
            fetchpriority="high"
            class="sticker-shadow mb-6 h-auto w-full max-w-[320px] animate-float"
          />
          <div class="w-full rounded-2xl border border-salsa-orange/40 bg-salsa-dark p-4 text-center">
            <span class="text-[11px] font-bold tracking-widest text-salsa-orange uppercase sm:text-xs"
              >{t('hero.response')}</span
            >
            <p class="mt-1 text-sm font-bold text-zinc-200 sm:text-base">HTTP 200 OK</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
