---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import elParchao from '../assets/el-parchao.webp';
import { highlights } from '../data/site';
---

<section class="relative pt-[calc(var(--header-h)+3.5rem)] pb-20 sm:pb-24 lg:pt-[calc(var(--header-h)+6rem)] lg:pb-32">
  <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="text-center lg:col-span-7 lg:text-left">
      <p class="eyebrow justify-center lg:justify-start">
        <span class="inline-block size-1.5 rounded-full bg-salsa-orange"></span>
        En construcción · Próximamente 100% AWS S3 Compatible
      </p>

      <h1 class="display-serif mt-6 text-[clamp(2.25rem,6vw+0.5rem,4.5rem)] text-balance">
        El Motor Caleño de S3 que corre con <em>Pura Salsa</em>.
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-pretty text-muted sm:text-lg lg:mx-0">
        Almacenamiento de objetos ultra-rápido distribuido compatible con S3, pensado para los developers de Cali y el
        mundo. ¿Necesitás subir un archivo volando?{' '}
        <code class="font-mono text-[0.9em] break-words text-ink">ve subi ./file.txt a chuspa://mi-parche/</code>{' '}y
        listo.
      </p>

      <div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:justify-start">
        <a href="#playground" class="btn-primary px-6 py-3 text-sm text-white sm:text-base">
          <Icon name="Play" class="size-4" />
          <span>Probar Comandos Caleños</span>
        </a>
        <a href="#sdks" class="btn-ghost px-6 py-3 text-sm sm:text-base">
          <Icon name="Code2" class="size-4" />
          <span>SDKs (Python, JS, Go)</span>
        </a>
      </div>

      <dl
        class="mt-14 flex flex-wrap justify-center gap-x-10 gap-y-6 border-t border-line pt-8 text-left sm:gap-x-14 lg:justify-start"
      >
        {
          highlights.map((h) => (
            <div>
              <dt class="font-mono text-[11px] tracking-wide text-muted uppercase">{h.label}</dt>
              <dd
                class:list={[
                  'mt-1 font-mono text-xl whitespace-nowrap sm:text-2xl',
                  h.accent ? 'text-salsa-orange' : 'text-ink',
                ]}
              >
                {h.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="flex justify-center lg:col-span-5">
      <figure class="w-full max-w-sm">
        <Image
          src={elParchao}
          alt="El Parchao, la mascota de OpenChuspa: un caleño sonriente que sostiene una chuspa llena de archivos y levanta el pulgar, con la frase «Vos sabés»"
          widths={[320, 480, elParchao.width]}
          sizes="(min-width: 400px) 360px, 80vw"
          quality={88}
          loading="eager"
          fetchpriority="high"
          class="mx-auto h-auto w-full max-w-[340px]"
        />
        <figcaption
          class="mt-4 flex items-center justify-center gap-2 font-mono text-xs text-muted"
        >
          <span class="inline-block size-1.5 rounded-full bg-salsa-orange"></span>
          HTTP 200 OK — "Vos sabés!"
        </figcaption>
      </figure>
    </div>
  </div>
</section>
