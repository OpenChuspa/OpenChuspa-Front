---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { commands } from '../data/site';
---

<section id="comandos" class="py-16 sm:py-24">
  <div class="container-page">
    <SectionHeader
      eyebrow="Documentación de Sintaxis CLI"
      title="Comandos chuspa-cli Caleños"
      description="Los comandos que usás a diario en AWS S3 CLI, traducidos exactamente al dialecto caleño auténtico."
    />

    <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        commands.map((c) => (
          <li class="flex min-w-0 flex-col bg-bg p-6 transition-colors hover:bg-surface">
            <div class="mb-4 flex items-center justify-between gap-3">
              <Icon name={c.icon} class={c.danger ? 'size-5 text-red-400' : 'size-5 text-salsa-orange'} />
              <span class="font-mono text-[11px] tracking-wide text-muted uppercase">{c.badge}</span>
            </div>
            <h3 class="font-mono text-lg text-ink">{c.name}</h3>
            <p class="mt-2 mb-4 grow text-sm text-muted">{c.description}</p>
            <code class="code-box block text-muted">{c.example}</code>
            <div class="mt-3 flex gap-2 font-mono text-xs">
              <button
                type="button"
                data-cmd={c.example}
                class="js-run-cmd flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-line px-3 py-2.5 text-muted transition-colors hover:border-salsa-orange hover:text-salsa-orange"
              >
                <Icon name="Terminal" class="size-3.5" />
                <span>Probar en la terminal</span>
              </button>
              <button
                type="button"
                data-copy={c.example}
                aria-label={`Copiar el comando ${c.name}`}
                title="Copiar comando"
                class="flex items-center justify-center rounded-lg border border-line px-3 py-2.5 text-muted transition-colors hover:border-salsa-orange hover:text-salsa-orange"
              >
                <Icon name="Copy" class="size-3.5" />
              </button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
