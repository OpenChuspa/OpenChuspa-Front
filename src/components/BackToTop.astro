---
import Icon from './Icon.astro';
import { getLang, useT } from '../i18n/ui';
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<a
  id="back-to-top"
  href="#"
  aria-label={t('top')}
  title={t('top')}
  data-visible="false"
  class="pointer-events-none fixed right-4 bottom-4 z-30 flex size-11 translate-y-4 items-center justify-center rounded-full border border-salsa-border bg-salsa-card text-zinc-200 opacity-0 shadow-xl transition hover:border-salsa-orange hover:text-salsa-orange data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 sm:right-6 sm:bottom-6"
>
  <Icon name="ArrowUp" class="size-5" />
</a>

<script>
  const backToTop = document.getElementById('back-to-top');
  const onScroll = () => {
    if (backToTop) backToTop.dataset.visible = String(window.scrollY > window.innerHeight);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
