---
import Icon from './Icon.astro';
import { navLinks } from '../data/site';

// En la home los anchors (#...) funcionan directo; en otras páginas (ej. /docs)
// deben apuntar a /#ancla para volver a la portada y hacer scroll.
const isHome = Astro.url.pathname === '/';
const links = navLinks.map((l) => ({
  ...l,
  href: l.href.startsWith('#') && !isHome ? `/${l.href}` : l.href,
}));
---

<header class="site-header inset-x-0 top-0 z-40">
  <!-- Aviso en construcción + reproductor de salsa -->
  <div
    class="flex h-(--banner-h) items-center justify-between gap-3 border-b border-line bg-surface px-3 font-mono text-[11px] tracking-wide text-muted sm:px-4 sm:text-xs"
  >
    <p class="flex min-w-0 items-center gap-2">
      <Icon name="Construction" class="size-3.5 text-salsa-orange" />
      <span class="truncate sm:hidden">En construcción</span>
      <span class="hidden truncate sm:inline"
        >En construcción — demo visual, aún no funciona de verdad. Pero ya suena salsa, parce.</span
      >
    </p>

    <div class="flex shrink-0 items-center gap-2">
      <button
        id="salsa-toggle"
        type="button"
        data-state="idle"
        aria-label="Reproducir salsa en vivo"
        title="Reproducir salsa en vivo"
        aria-pressed="false"
        class="group flex h-7 items-center gap-1.5 rounded-full border border-line px-3 text-ink transition-colors hover:border-salsa-orange hover:text-salsa-orange data-[state=loading]:cursor-progress data-[state=playing]:border-salsa-orange data-[state=playing]:text-salsa-orange"
      >
        <Icon name="Play" class="size-3.5 group-data-[state=loading]:hidden group-data-[state=playing]:hidden" />
        <Icon name="LoaderCircle" class="hidden size-3.5 animate-spin group-data-[state=loading]:block" />
        <Icon name="Pause" class="hidden size-3.5 group-data-[state=playing]:block" />
        <span class="hidden h-3 items-end gap-[2px] sm:flex" aria-hidden="true">
          {
            [40, 100, 60, 85].map((h, i) => (
              <span class="eq-bar w-[2px] bg-salsa-orange" style={`height:${h}%;--i:${i}`} />
            ))
          }
        </span>
        <span id="salsa-label" class="whitespace-nowrap">Poné salsa</span>
      </button>
      <input
        id="salsa-vol"
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.6"
        aria-label="Volumen"
        class="hidden w-16 cursor-pointer accent-salsa-orange md:block"
      />
    </div>

    <!-- Sin crossorigin: evita el preflight CORS; para solo reproducir no se necesita. -->
    <audio id="salsa-audio" preload="none"></audio>
  </div>

  <nav aria-label="Principal" class="border-b border-salsa-border bg-salsa-dark/90 backdrop-blur-xl">
    <div class="container-page flex h-(--nav-h) items-center justify-between gap-3">
      <a href="/" aria-label="openchuspa.xyz, ir al inicio" class="flex min-w-0 items-center gap-2.5 transition-opacity hover:opacity-80 sm:gap-3">
        <span
          class="flex size-9 shrink-0 items-center justify-center rounded-xl border border-line bg-surface lg:size-10"
        >
          <Icon name="ShoppingBag" class="size-5 text-salsa-orange" />
        </span>
        <span class="min-w-0">
          <span class="block truncate text-lg font-semibold tracking-tight text-ink lg:text-xl"
            >open<span class="text-salsa-orange">chuspa</span><span class="text-muted">.xyz</span></span
          >
          <span class="-mt-0.5 hidden font-mono text-[10px] tracking-widest text-muted uppercase min-[360px]:block"
            >S3 Caleño Engine</span
          >
        </span>
      </a>

      <div class="hidden items-center gap-6 text-sm font-semibold text-muted lg:flex xl:gap-8">
        {links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <a href="#playground" class="btn-primary hidden px-4 py-2.5 text-sm sm:inline-flex">
          <Icon name="Terminal" class="size-4" />
          <span>Abrir Consola Caleña</span>
        </a>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar entre modo noche y día"
          title="Cambiar tema"
          class="flex size-10 items-center justify-center rounded-xl border border-salsa-border text-muted transition-colors hover:border-salsa-orange hover:bg-salsa-card hover:text-salsa-orange"
        >
          <Icon name="Moon" class="size-5 theme-icon-dark" />
          <Icon name="Sun" class="size-5 theme-icon-light" />
        </button>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="group flex size-10 items-center justify-center rounded-xl border border-salsa-border text-muted transition-colors hover:border-salsa-orange hover:bg-salsa-card hover:text-salsa-orange lg:hidden"
        >
          <Icon name="Menu" class="size-5 group-aria-expanded:hidden" />
          <Icon name="X" class="hidden size-5 group-aria-expanded:block" />
        </button>
      </div>
    </div>

    <div id="mobile-menu" hidden class="border-t border-salsa-border lg:hidden">
      <div class="container-page flex max-h-[calc(100dvh-var(--header-h))] flex-col overflow-y-auto py-3">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="rounded-lg px-3 py-3 font-semibold text-muted transition-colors hover:bg-salsa-card active:bg-salsa-border aria-[current=true]:bg-salsa-card aria-[current=true]:text-salsa-orange"
            >
              {l.label}
            </a>
          ))
        }
        <a href="#playground" class="btn-primary mt-2 px-4 py-3 text-sm sm:hidden">
          <Icon name="Terminal" class="size-4" />
          <span>Abrir Consola Caleña</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // ====== Menú móvil ======
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setMenu(open: boolean) {
    if (!menuToggle || !menu) return;
    menu.hidden = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  menuToggle?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  // Al pasar a escritorio el menú móvil no debe quedar abierto.
  window.matchMedia('(width >= 64rem)').addEventListener('change', () => setMenu(false));

  // ====== Modo noche / día ======
  const themeToggle = document.getElementById('theme-toggle');
  const THEME_META = document.querySelector('meta[name="theme-color"]');
  function applyTheme(theme: 'dark' | 'light') {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('chuspa-theme', theme);
    } catch {
      /* almacenamiento no disponible: el tema vale solo para esta sesión */
    }
    THEME_META?.setAttribute('content', theme === 'light' ? '#fcfcfc' : '#0a0a0a');
  }
  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    applyTheme(current === 'light' ? 'dark' : 'light');
  });

  // ====== Sección activa en la navegación ======
  const spyLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-header a[href^="#"]:not([href="#"])')];
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of spyLinks) {
          if (link.classList.contains('btn-primary')) continue;
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    // Una sección está "activa" cuando cruza la franja central de la pantalla
    { rootMargin: '-45% 0px -50% 0px' }
  );
  document.querySelectorAll('main section[id]').forEach((section) => spy.observe(section));

  // ====== Reproductor de salsa (Yo Soy Cali Salsa, stream en vivo) ======
  const SALSA_STREAM = 'https://stream.integracionvirtual.com/proxy/yosoycalisalsa?mp=/stream';
  const LOAD_TIMEOUT_MS = 15_000;

  type PlayerState = 'idle' | 'loading' | 'playing' | 'error';
  const PLAYER_UI: Record<PlayerState, { label: string; hint: string }> = {
    idle: { label: 'Poné salsa', hint: 'Reproducir salsa en vivo' },
    loading: { label: 'Cargando…', hint: 'Conectando con la emisora (clic para cancelar)' },
    playing: { label: 'Sonando salsa', hint: 'Pausar la salsa' },
    error: { label: 'Reintentar', hint: 'No se pudo conectar con la emisora. Clic para reintentar' },
  };

  const audio = document.getElementById('salsa-audio') as HTMLAudioElement | null;
  const toggle = document.getElementById('salsa-toggle');
  const label = document.getElementById('salsa-label');
  const vol = document.getElementById('salsa-vol') as HTMLInputElement | null;

  if (audio && toggle) {
    let state: PlayerState = 'idle';
    let loadTimer: number | undefined;
    let byUser = false; // un intento automático que falla no molesta: vuelve a reposo sin avisar
    audio.volume = vol ? parseFloat(vol.value) : 0.6;

    const setState = (next: PlayerState) => {
      state = next;
      toggle.dataset.state = next;
      toggle.setAttribute('aria-pressed', String(next === 'playing'));
      toggle.setAttribute('aria-busy', String(next === 'loading'));
      toggle.setAttribute('aria-label', PLAYER_UI[next].hint);
      toggle.title = PLAYER_UI[next].hint;
      if (label) label.textContent = PLAYER_UI[next].label;
      window.clearTimeout(loadTimer);
      if (next === 'loading') loadTimer = window.setTimeout(fail, LOAD_TIMEOUT_MS);
    };

    // Suelta la conexión: al volver a darle play se engancha al directo, no a un buffer viejo.
    const release = () => {
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
    };

    const fail = () => {
      setState(byUser ? 'error' : 'idle');
      release();
      if (byUser) {
        document.dispatchEvent(new CustomEvent('toast', { detail: 'No se pudo conectar con la emisora. Probá de nuevo' }));
      }
    };

    const start = async (fromUser: boolean) => {
      byUser = fromUser;
      setState('loading');
      audio.src = `${SALSA_STREAM}&_t=${Date.now()}`;
      try {
        await audio.play();
      } catch (err) {
        if (state !== 'loading') return; // el usuario canceló o ya se reportó el fallo
        // Incluye el autoplay bloqueado por el navegador: queda listo para el primer gesto
        fail();
      }
    };

    toggle.addEventListener('click', () => {
      if (state === 'idle' || state === 'error') start(true);
      else {
        setState('idle');
        release();
      }
    });

    audio.addEventListener('playing', () => {
      if (state !== 'idle') setState('playing');
    });
    audio.addEventListener('waiting', () => {
      if (state === 'playing') setState('loading');
    });
    audio.addEventListener('error', () => {
      if (state === 'loading' || state === 'playing') fail();
    });
    vol?.addEventListener('input', () => {
      audio.volume = parseFloat(vol.value);
    });

    // Intento de autoplay al entrar; si el navegador lo bloquea, arranca con el
    // primer gesto en la página. Solo una vez, y nunca si ese gesto es sobre el
    // propio botón (ahí manda el clic) para no encender y apagar en el mismo toque.
    start(false);
    const GESTURES = ['pointerdown', 'keydown'];
    const kickstart = (e: Event) => {
      GESTURES.forEach((g) => window.removeEventListener(g, kickstart));
      if (state === 'idle' && !toggle.contains(e.target as Node) && !vol?.contains(e.target as Node)) start(false);
    };
    GESTURES.forEach((g) => window.addEventListener(g, kickstart));
  }
</script>
