---
import SectionHeader from './SectionHeader.astro';
import { glossary } from '../data/site';
---

<section id="glosario" class="py-16 sm:py-24">
  <div class="container-page">
    <SectionHeader
      eyebrow="Glosario Arquitectónico"
      title="Diccionario Caleño S3"
      description="Entendé las equivalencias técnicas del motor S3 traducidas al lenguaje de la sultana."
    />

    <dl class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        glossary.map((g) => (
          <div class="min-w-0 bg-bg p-6 transition-colors hover:bg-surface">
            <div class="mb-2 font-mono text-[11px] tracking-wide text-salsa-orange uppercase">AWS S3: {g.aws}</div>
            <dt class="text-lg text-balance text-ink sm:text-xl">{g.term}</dt>
            <dd class="mt-2 text-sm leading-relaxed break-words text-muted">{g.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
