<script>
  // ====== Estado de la simulación del Terminal Playground ======
  type MockState = Record<string, string[]>;

  const mockState: MockState = {
    'prod-chuspa-name': ['test/file.txt', 'music/cancion.mp3', 'fotos/cali.jpg'],
    'backup-chuspa': ['database_dump.sql.gz'],
  };

  function $(id: string): HTMLElement | null {
    return document.getElementById(id);
  }

  // ====== Render Buckets Visualizer ======
  function renderBuckets() {
    const container = $('buckets-tree');
    if (!container) return;
    container.innerHTML = '';

    const keys = Object.keys(mockState);
    const count = $('bucket-count');
    if (count) count.textContent = `${keys.length} Chuspas`;

    keys.forEach((bucket) => {
      const bBox = document.createElement('div');
      bBox.className = 'bg-salsa-card border border-salsa-border p-3 rounded-xl';

      const filesHtml = mockState[bucket]
        .map(
          (f) =>
            `<div class="flex items-center justify-between text-[11px] text-slate-400 pl-4 py-0.5">
                <span class="truncate">📄 ${f}</span>
                <span class="text-salsa-lime text-[10px]">OK</span>
             </div>`
        )
        .join('');

      bBox.innerHTML = `
        <div class="flex items-center justify-between text-salsa-orange font-bold mb-1">
          <span>🛍️ chuspa://${bucket}</span>
          <span class="text-[10px] text-slate-500">(${mockState[bucket].length} chucherías)</span>
        </div>
        ${filesHtml || '<div class="text-[11px] text-slate-600 pl-4">Chuspa vacía</div>'}
      `;
      container.appendChild(bBox);
    });
  }

  // ====== Terminal Command Processor ======
  function runCommand(cmd: string) {
    const screen = $('terminal-screen');
    if (!screen) return;

    const userLine = document.createElement('div');
    userLine.className = 'text-white font-bold flex items-center space-x-2 mt-3';
    userLine.innerHTML = `<span class="text-salsa-lime">caleño@openchuspa:~$</span> <span>${cmd}</span>`;
    screen.appendChild(userLine);

    const resp = document.createElement('div');
    resp.className = 'pl-4 border-l-2 border-salsa-orange my-1 text-slate-300';

    if (cmd === 'ayuda') {
      resp.innerHTML = `
        <span class="text-salsa-orange font-bold">Comandos Caleños disponibles:</span><br>
        • <span class="text-salsa-lime">ve mira chuspa://</span> : Listar chuspas o contenido<br>
        • <span class="text-salsa-cyan">ve crea chuspa://nombre</span> : Crear nueva chuspa<br>
        • <span class="text-salsa-orange">ve subi ./file a chuspa://nombre/path/</span> : Subir archivo<br>
        • <span class="text-salsa-pink">ve baja chuspa://nombre/path/file .</span> : Descargar archivo<br>
        • <span class="text-red-400">ve borra chuspa://nombre/path/file</span> : Eliminar archivo
      `;
    } else if (cmd.startsWith('ve mira')) {
      const parts = cmd.split(' ');
      const target = parts[2] || 'chuspa://';
      if (target === 'chuspa://') {
        const list = Object.keys(mockState)
          .map((k) => `🛍️ chuspa://${k}/`)
          .join('<br>');
        resp.innerHTML = `<span class="text-salsa-cyan">Listando Chuspas Caleñas:</span><br>${list}`;
      } else {
        const chuspaName = target.replace('chuspa://', '').split('/')[0];
        if (mockState[chuspaName]) {
          const files = mockState[chuspaName].map((f) => `  📄 ${f}`).join('<br>');
          resp.innerHTML = `<span class="text-salsa-cyan">Contenido de chuspa://${chuspaName}:</span><br>${files || '  (Chuspa vacía)'}`;
        } else {
          resp.innerHTML = `<span class="text-red-400">¡Oíste! La chuspa '${chuspaName}' no existe aún. Creala con 've crea chuspa://${chuspaName}'</span>`;
        }
      }
    } else if (cmd.startsWith('ve crea')) {
      const parts = cmd.split(' ');
      const target = parts[2] || '';
      const chuspaName = target.replace('chuspa://', '').replace('/', '');
      if (chuspaName) {
        if (!mockState[chuspaName]) {
          mockState[chuspaName] = [];
          resp.innerHTML = `<span class="text-salsa-lime">¡Chuspa creada con éxito!</span><br>HTTP 200 OK — s3://${chuspaName} lista en 'cali-san-antonio-1'. ¡Vos sabés!`;
          renderBuckets();
        } else {
          resp.innerHTML = `<span class="text-salsa-orange">Esa chuspa '${chuspaName}' ya existe en el parqueo.</span>`;
        }
      } else {
        resp.innerHTML = `<span class="text-red-400">Sintaxis: ve crea chuspa://nombre-de-chuspa</span>`;
      }
    } else if (cmd.startsWith('ve subi')) {
      const match = cmd.match(/ve subi (.+) a chuspa:\/\/([^\/]+)\/?(.*)/);
      if (match) {
        const localFile = match[1].replace('./', '');
        const chuspaName = match[2];
        const targetPath = match[3] || '';
        const fullPath = targetPath ? (targetPath.endsWith('/') ? targetPath + localFile : targetPath) : localFile;

        if (!mockState[chuspaName]) mockState[chuspaName] = [];
        mockState[chuspaName].unshift(fullPath);
        renderBuckets();

        resp.innerHTML = `
          <span class="text-salsa-lime font-bold">¡Empacado en Chuspa exitoso! 📦</span><br>
          Local: <span class="text-white">${localFile}</span> ➔ Remote: <span class="text-salsa-cyan">chuspa://${chuspaName}/${fullPath}</span><br>
          Velocidad: 820 MB/s • Sello Caleño S3: VÁLIDO
        `;
      } else {
        resp.innerHTML = `<span class="text-salsa-orange">Uso correcto: ve subi ./archivo.txt a chuspa://nombre-chuspa/ruta/</span>`;
      }
    } else if (cmd.startsWith('ve baja')) {
      resp.innerHTML = `
        <span class="text-salsa-cyan font-bold">Sacando de la chuspa... 👐</span><br>
        Descargado en tu directorio local. ¡Todo bien, todo bonito!
      `;
    } else if (cmd.startsWith('ve borra')) {
      resp.innerHTML = `<span class="text-red-400">Objeto borrado de la chuspa. ¡Limpieza caleña efectuada!</span>`;
    } else {
      resp.innerHTML = `<span class="text-slate-400">Comando no reconocido. Escribí <strong class="text-salsa-orange">'ayuda'</strong> para ver la guía de la chuspa.</span>`;
    }

    screen.appendChild(resp);
    screen.scrollTop = screen.scrollHeight;
  }

  // ====== Custom Command Generator Logic ======
  function generateCustomCommand() {
    const actionEl = $('gen-action') as HTMLSelectElement | null;
    const fileEl = $('gen-file') as HTMLInputElement | null;
    const chuspaEl = $('gen-chuspa') as HTMLInputElement | null;
    if (!actionEl || !fileEl || !chuspaEl) return;

    const action = actionEl.value;
    const file = fileEl.value.trim() || './archivo.txt';
    const chuspa = chuspaEl.value.trim() || 'prod-chuspa-name';

    let caleñoCmd = '';
    let awsCmd = '';

    if (action === 'subi') {
      caleñoCmd = `ve subi ${file} a chuspa://${chuspa}/test/`;
      awsCmd = `aws s3 cp ${file} s3://${chuspa}/test/ --endpoint-url https://s3.openchuspa.xyz`;
    } else if (action === 'baja') {
      caleñoCmd = `ve baja chuspa://${chuspa}/test/${file.replace('./', '')} .`;
      awsCmd = `aws s3 cp s3://${chuspa}/test/${file.replace('./', '')} . --endpoint-url https://s3.openchuspa.xyz`;
    } else if (action === 'crea') {
      caleñoCmd = `ve crea chuspa://${chuspa}`;
      awsCmd = `aws s3 mb s3://${chuspa} --endpoint-url https://s3.openchuspa.xyz`;
    } else if (action === 'mira') {
      caleñoCmd = `ve mira chuspa://${chuspa}/`;
      awsCmd = `aws s3 ls s3://${chuspa}/ --endpoint-url https://s3.openchuspa.xyz`;
    } else if (action === 'borra') {
      caleñoCmd = `ve borra chuspa://${chuspa}/test/${file.replace('./', '')}`;
      awsCmd = `aws s3 rm s3://${chuspa}/test/${file.replace('./', '')} --endpoint-url https://s3.openchuspa.xyz`;
    }

    const out = $('gen-output');
    const equiv = $('gen-aws-equiv');
    if (out) out.innerText = caleñoCmd;
    if (equiv) equiv.innerText = awsCmd;
  }

  // ====== SDK Code Tabs ======
  const sdkSnippets: Record<string, { title: string; code: string }> = {
