---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Toast Notification Message Box -->
  <div
    id="toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-salsa-card border border-salsa-orange/40 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center space-x-3 font-mono text-xs"
  >
    <i data-lucide="sparkles" class="w-4 h-4 text-salsa-orange"></i>
    <span id="toast-msg">Mensaje de confirmación</span>
  </div>

  <!-- Banner global: aviso en construcción + reproductor de salsa -->
  <div
    id="construction-banner"
    class="fixed top-0 left-0 right-0 z-50 h-10 bg-salsa-orange text-black flex items-center justify-between gap-3 px-3 sm:px-4 font-mono text-[10px] sm:text-xs font-bold tracking-wide"
  >
    <!-- Aviso -->
    <div class="flex items-center min-w-0">
      <i data-lucide="construction" class="w-4 h-4 mr-2 shrink-0"></i>
      <span class="truncate">🚧 Sitio en construcción — demo visual, aún no funciona de verdad. ¡Pero ya suena salsa, parce!</span>
    </div>

    <!-- Mini reproductor de salsa -->
    <div class="flex items-center gap-2 shrink-0">
      <button
        id="salsa-toggle"
        type="button"
        aria-label="Reproducir / pausar salsa"
        class="flex items-center gap-1.5 bg-black/85 text-salsa-orange hover:bg-black px-2.5 py-1 rounded-full transition-colors"
      >
        <i data-lucide="play" id="salsa-icon" class="w-3.5 h-3.5"></i>
        <span class="hidden sm:flex items-end gap-[2px] h-3" id="salsa-eq" aria-hidden="true">
          <span class="w-[2px] bg-salsa-orange" style="height:40%"></span>
          <span class="w-[2px] bg-salsa-orange" style="height:100%"></span>
          <span class="w-[2px] bg-salsa-orange" style="height:60%"></span>
          <span class="w-[2px] bg-salsa-orange" style="height:85%"></span>
        </span>
        <span class="whitespace-nowrap" id="salsa-label">Poné salsa 🎺</span>
      </button>
      <input
        id="salsa-vol"
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.6"
        aria-label="Volumen"
        class="hidden md:block w-16 accent-black cursor-pointer"
      />
    </div>

    <!-- Audio: Yo Soy Cali Salsa (stream en vivo) -->
    <audio id="salsa-audio" preload="none" crossorigin="anonymous" class="hidden"></audio>
  </div>

  <nav class="fixed top-10 left-0 right-0 z-40 bg-salsa-dark/90 backdrop-blur-xl border-b border-salsa-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-salsa-orange via-salsa-pink to-salsa-cyan p-0.5 shadow-lg shadow-salsa-orange/20">
          <div class="w-full h-full bg-salsa-dark rounded-[14px] flex items-center justify-center">
            <i data-lucide="shopping-bag" class="w-5 h-5 text-salsa-orange"></i>
          </div>
        </div>
        <div>
          <a href="#" class="text-2xl font-black tracking-tight text-white"
            >open<span class="text-salsa-orange">chuspa</span><span class="text-salsa-cyan">.xyz</span></a
          >
          <span class="block text-[10px] font-mono text-salsa-lime uppercase tracking-widest -mt-1"
            >MinIO / S3 Caleño Engine</span
          >
        </div>
      </div>

      <div class="hidden lg:flex items-center space-x-8 text-sm font-semibold text-slate-300">
        <a href="#playground" class="hover:text-salsa-orange transition-colors">Terminal Interactive</a>
        <a href="#comandos" class="hover:text-salsa-cyan transition-colors">Comandos CLI</a>
        <a href="#glosario" class="hover:text-salsa-lime transition-colors">Glosario Caleño</a>
        <a href="#generador" class="hover:text-salsa-purple transition-colors">Generador</a>
        <a href="#sdks" class="hover:text-salsa-orange transition-colors">SDKs & MinIO</a>
      </div>

      <div class="flex items-center space-x-3">
        <a
          href="#playground"
          class="bg-gradient-to-r from-salsa-orange to-salsa-pink text-white font-extrabold px-5 py-2.5 rounded-xl text-xs sm:text-sm shadow-xl hover:shadow-salsa-orange/30 hover:scale-105 transition-all flex items-center space-x-2"
        >
          <i data-lucide="terminal" class="w-4 h-4"></i>
          <span>Abrir Consola Caleña</span>
        </a>
      </div>
    </div>
  </nav>

  <section class="relative pt-44 pb-20 lg:pt-52 lg:pb-28 overflow-hidden">
    <!-- Ambient Glowing Background -->
    <div
      class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-salsa-orange/15 rounded-full blur-[160px] pointer-events-none"
    >
    </div>
    <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] bg-salsa-cyan/15 rounded-full blur-[140px] pointer-events-none">
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Left Column -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <div
            class="inline-flex items-center space-x-2 bg-salsa-card border border-salsa-orange/40 px-4 py-2 rounded-full mb-6 shadow-xl shadow-salsa-orange/10"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-salsa-lime animate-ping"></span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-salsa-orange"
              >🚧 En construcción · Próximamente 100% MinIO & AWS S3 Compatible</span
            >
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6">
            El Motor Caleño de S3 que corre con <span class="gradient-text-salsa">Pura Salsa</span>.
          </h1>

          <p class="text-lg sm:text-xl text-slate-300 mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            Almacenamiento de objetos ultra-rápido distribuido tipo MinIO, pensado para los developers de Cali y el
            mundo. ¿Necesitás subir un archivo volando?
            <strong class="text-salsa-orange">`ve subi ./file.txt a chuspa://mi-parche/`</strong> y listo.
          </p>

          <!-- Primary Actions -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
            <a
              href="#playground"
              class="w-full sm:w-auto bg-gradient-to-r from-salsa-orange via-salsa-pink to-salsa-purple text-white font-extrabold px-8 py-4 rounded-2xl shadow-xl hover:shadow-salsa-orange/30 hover:scale-105 transition-all text-center flex items-center justify-center space-x-3 text-base"
            >
              <i data-lucide="play" class="w-5 h-5 text-salsa-lime"></i>
              <span>Probar Comandos Caleños</span>
            </a>
            <a
              href="#sdks"
              class="w-full sm:w-auto bg-salsa-card hover:bg-salsa-border border border-salsa-border text-slate-200 font-semibold px-8 py-4 rounded-2xl transition-all text-center flex items-center justify-center space-x-2 text-base"
            >
              <i data-lucide="code-2" class="w-5 h-5 text-salsa-cyan"></i>
              <span>SDKs (Python, JS, Go)</span>
            </a>
          </div>

          <!-- Highlights Banner -->
          <div class="grid grid-cols-3 gap-4 mt-12 pt-8 border-t border-salsa-border">
            <div class="text-left">
              <div class="text-[11px] font-mono uppercase text-slate-400">Latencia en Cali</div>
              <div class="text-lg sm:text-2xl font-black text-salsa-lime font-mono">0.4 ms</div>
            </div>
            <div class="text-left">
              <div class="text-[11px] font-mono uppercase text-slate-400">Standard API</div>
              <div class="text-lg sm:text-2xl font-black text-salsa-cyan font-mono">MinIO / S3</div>
            </div>
            <div class="text-left">
              <div class="text-[11px] font-mono uppercase text-slate-400">Garantía Caleña</div>
              <div class="text-lg sm:text-2xl font-black text-salsa-orange font-mono">Vos Sabés 😉</div>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: Caleño Sticker Hero Card -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md">
            <!-- Glowing backdrop ring -->
            <div
              class="absolute inset-0 bg-gradient-to-tr from-salsa-orange via-salsa-pink to-salsa-cyan rounded-3xl blur-2xl opacity-40 animate-pulse-glow"
            >
            </div>

            <div class="relative bg-salsa-card border-2 border-salsa-border p-8 rounded-3xl shadow-2xl flex flex-col items-center">
              <!-- Sticker SVG Render -->
              <div class="relative w-full aspect-square max-w-[320px] mb-6 flex items-center justify-center p-2 animate-float">
                <svg class="w-full h-full sticker-shadow" viewBox="0 0 500 520" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <!-- Die-Cut White Sticker Outer Outline -->
                  <path
                    d="M 250 15 C 350 15, 410 40, 440 100 C 470 160, 480 230, 460 300 C 440 370, 430 430, 390 470 C 350 505, 150 505, 110 470 C 70 430, 60 370, 40 300 C 20 230, 30 160, 60 100 C 90 40, 150 15, 250 15 Z"
                    fill="#FFFFFF"
                    stroke="#CBD5E1"
                    stroke-width="12"
                    stroke-linejoin="round"></path>

                  <!-- Inner Dark Silhouette Base -->
                  <path
                    d="M 250 30 C 340 30, 395 55, 420 110 C 445 165, 455 230, 438 295 C 420 360, 410 415, 375 450 C 340 480, 160 480, 125 450 C 90 415, 80 360, 62 295 C 45 230, 55 165, 80 110 C 105 55, 160 30, 250 30 Z"
                    fill="#0A0C14"></path>

                  <!-- Head Structure -->
                  <ellipse cx="250" cy="170" rx="95" ry="105" fill="#B27A59"></ellipse>

                  <!-- Short Hair Cut -->
                  <path
                    d="M 155 160 C 155 100, 190 70, 250 70 C 310 70, 345 100, 345 160 C 345 110, 310 80, 250 80 C 190 80, 155 110, 155 160 Z"
                    fill="#1C1512"></path>

                  <!-- Eyes & Eyebrows -->
                  <ellipse cx="210" cy="155" rx="10" ry="8" fill="#1A110B"></ellipse>
                  <ellipse cx="290" cy="155" rx="10" ry="8" fill="#1A110B"></ellipse>
                  <path d="M 195 140 Q 210 135 225 142" stroke="#1A110B" stroke-width="5" stroke-linecap="round"></path>
                  <path d="M 275 142 Q 290 135 305 140" stroke="#1A110B" stroke-width="5" stroke-linecap="round"></path>

                  <!-- Smile with Teeth -->
                  <path d="M 200 190 Q 250 225 300 190 Z" fill="#FFFFFF" stroke="#804B2A" stroke-width="3"></path>
                  <path d="M 205 192 Q 250 202 295 192" stroke="#E5E7EB" stroke-width="2"></path>

                  <!-- Black Shirt Base -->
                  <path
                    d="M 100 320 C 100 250, 150 240, 250 240 C 350 240, 400 250, 400 320 L 410 470 L 90 470 Z"
                    fill="#18181B"></path>

                  <!-- Crossed Arms Gesture -->
                  <path
                    d="M 110 330 Q 250 390 390 330 C 390 410, 340 440, 250 440 C 160 440, 110 410, 110 330 Z"
                    fill="#A0694A"
                    stroke="#18181B"
                    stroke-width="6"></path>

                  <!-- Smartwatch -->
                  <rect x="180" y="360" width="35" height="35" rx="10" fill="#090A0F" stroke="#3F3F46" stroke-width="3"></rect>
                  <circle cx="197" cy="377" r="10" fill="#FF6B00" opacity="0.9"></circle>

                  <!-- Bold Text Phrase: "Vos sabés" -->
                  <text
                    x="250"
                    y="295"
                    text-anchor="middle"
                    font-family="system-ui, -apple-system, sans-serif"
                    font-weight="900"
                    font-size="42"
                    fill="#FFFFFF"
                    style="letter-spacing: -0.5px;">Vos sabés</text
                  >
                </svg>
              </div>

              <!-- Badge Quote -->
              <div class="w-full bg-salsa-dark border border-salsa-orange/40 rounded-2xl p-4 text-center">
                <span class="text-xs font-mono uppercase tracking-widest text-salsa-orange font-bold">Respuesta del Servidor S3</span>
                <p class="text-base font-mono font-bold text-salsa-lime mt-1">HTTP 200 OK — "Vos sabés!"</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="playground" class="py-20 bg-salsa-card/80 border-y border-salsa-border relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span
          class="text-salsa-lime font-mono text-xs font-bold tracking-widest uppercase bg-salsa-lime/10 px-4 py-1.5 rounded-full border border-salsa-lime/20"
          >Consola Interactiva `chuspa-cli`</span
        >
        <h2 class="text-3xl sm:text-5xl font-black mt-4 mb-4">Probá el CLI Caleño en Vivo</h2>
        <p class="text-slate-400 text-lg">
          Escribí tus comandos con la jerga caleña real y mira cómo responde el motor de almacenamiento.
        </p>
      </div>

      <!-- Terminal Component Window -->
      <div class="bg-salsa-dark border-2 border-salsa-border rounded-3xl overflow-hidden shadow-2xl">
        <!-- Terminal Title Bar -->
        <div class="bg-[#0B0E17] px-6 py-4 border-b border-salsa-border flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="w-3.5 h-3.5 rounded-full bg-red-500/80"></div>
            <div class="w-3.5 h-3.5 rounded-full bg-yellow-500/80"></div>
            <div class="w-3.5 h-3.5 rounded-full bg-green-500/80"></div>
            <span class="ml-4 font-mono text-xs text-slate-400">caleño-terminal@openchuspa:~ (chuspa-cli v2.6.0)</span>
          </div>
          <span class="text-[11px] font-mono text-salsa-cyan bg-salsa-cyan/10 px-2.5 py-1 rounded-md border border-salsa-cyan/20"
            >Motor: MinIO Core Caleño</span
          >
        </div>

        <!-- Quick Command Buttons -->
        <div class="bg-salsa-card px-6 py-3 border-b border-salsa-border flex flex-wrap gap-2 items-center text-xs font-mono">
          <span class="text-slate-400">Atajos de comando:</span>
          <button
            data-cmd="ve mira chuspa://"
            class="js-run-cmd bg-salsa-dark hover:bg-salsa-border text-salsa-orange px-3 py-1.5 rounded-lg border border-salsa-border"
            >1. ve mira chuspa://</button
          >
          <button
            data-cmd="ve crea chuspa://feria-de-cali"
            class="js-run-cmd bg-salsa-dark hover:bg-salsa-border text-salsa-cyan px-3 py-1.5 rounded-lg border border-salsa-border"
            >2. ve crea chuspa://feria-de-cali</button
          >
          <button
            data-cmd="ve subi ./cancion.mp3 a chuspa://prod-chuspa-name/music/"
            class="js-run-cmd bg-salsa-dark hover:bg-salsa-border text-salsa-lime px-3 py-1.5 rounded-lg border border-salsa-border"
            >3. ve subi ./cancion.mp3</button
          >
          <button
            data-cmd="ve baja chuspa://prod-chuspa-name/music/cancion.mp3 ."
            class="js-run-cmd bg-salsa-dark hover:bg-salsa-border text-salsa-pink px-3 py-1.5 rounded-lg border border-salsa-border"
            >4. ve baja chuspa://...</button
          >
        </div>

        <!-- Split Console & Mock Bucket State -->
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[420px]">
          <!-- Terminal Input/Output (Left 7 cols) -->
          <div class="lg:col-span-7 p-6 font-mono text-xs sm:text-sm flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-salsa-border">
            <div id="terminal-screen" class="space-y-3 max-h-[360px] overflow-y-auto pr-2">
              <div class="text-slate-500">
                OpenChuspa CLI v2.6.0 (compatible con MinIO Client / mc)<br />
                Escribí <span class="text-salsa-orange">'ayuda'</span> o probá comandos como
                <span class="text-salsa-lime">'ve mira'</span>, <span class="text-salsa-cyan">'ve subi'</span>,
                <span class="text-salsa-pink">'ve baja'</span>.
              </div>
            </div>

            <!-- Prompt Line -->
            <form id="terminal-form" class="mt-4 flex items-center space-x-2 bg-salsa-card/80 p-2.5 rounded-xl border border-salsa-border">
              <span class="text-salsa-lime font-bold">caleño@openchuspa:~$</span>
              <input
                type="text"
                id="terminal-input"
                autocomplete="off"
                placeholder="ve subi ./foto.png a chuspa://prod-chuspa-name/test/"
                class="flex-1 bg-transparent text-white focus:outline-none font-mono text-xs sm:text-sm"
              />
              <button type="submit" class="bg-salsa-orange hover:bg-salsa-orange/90 text-white px-4 py-1.5 rounded-lg font-bold text-xs"
                >Ejecutar</button
              >
            </form>
          </div>

          <!-- Live Bucket Visualizer (Right 5 cols) -->
          <div class="lg:col-span-5 p-6 bg-salsa-dark/50 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono text-salsa-cyan uppercase tracking-wider font-bold flex items-center space-x-2">
                  <i data-lucide="folder-tree" class="w-4 h-4 text-salsa-cyan"></i>
                  <span>Estado en Vivo de tus Chuspas</span>
                </span>
                <span id="bucket-count" class="text-[11px] font-mono bg-salsa-orange/20 text-salsa-orange px-2 py-0.5 rounded">2 Chuspas</span>
              </div>

              <div id="buckets-tree" class="space-y-3 font-mono text-xs">
                <!-- Initial Chuspa State Rendered by JS -->
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-salsa-border">
              <span class="text-[11px] font-mono text-slate-500 block mb-1">Sucursal del Cielo (Región actual):</span>
              <div class="text-xs font-mono text-salsa-lime flex items-center space-x-2">
                <i data-lucide="map-pin" class="w-4 h-4 text-salsa-lime"></i>
                <span>cali-san-antonio-1 (Latencia: 0.3ms)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="comandos" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span
          class="text-salsa-orange font-mono text-xs font-bold tracking-widest uppercase bg-salsa-orange/10 px-4 py-1.5 rounded-full border border-salsa-orange/20"
          >Documentación de Sintaxis CLI</span
        >
        <h2 class="text-3xl sm:text-5xl font-black mt-4 mb-4">Comandos `chuspa-cli` Caleños</h2>
        <p class="text-slate-400 text-lg">
          Los comandos que usás a diario en AWS S3 o MinIO CLI, traducidos exactamente al dialecto caleño auténtico.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Command 1: Upload -->
        <div class="bg-salsa-card border border-salsa-border p-6 rounded-3xl hover:border-salsa-orange transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono bg-salsa-orange/10 text-salsa-orange px-3 py-1 rounded-lg font-bold">PUT / Upload</span>
            <i data-lucide="upload-cloud" class="w-5 h-5 text-salsa-orange"></i>
          </div>
          <h3 class="text-xl font-black text-white mb-2">ve subi</h3>
          <p class="text-slate-400 text-xs mb-4">Empaca y sube un archivo local directamente a tu chuspa.</p>
          <div class="bg-salsa-dark p-3 rounded-xl font-mono text-xs text-salsa-lime border border-salsa-border">
            <code>ve subi ./file.txt a chuspa://prod-chuspa-name/test/</code>
          </div>
        </div>

        <!-- Command 2: Download -->
        <div class="bg-salsa-card border border-salsa-border p-6 rounded-3xl hover:border-salsa-cyan transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono bg-salsa-cyan/10 text-salsa-cyan px-3 py-1 rounded-lg font-bold">GET / Download</span>
            <i data-lucide="download-cloud" class="w-5 h-5 text-salsa-cyan"></i>
          </div>
          <h3 class="text-xl font-black text-white mb-2">ve baja</h3>
          <p class="text-slate-400 text-xs mb-4">Saca un objeto de la chuspa y lo descarga en tu directorio.</p>
          <div class="bg-salsa-dark p-3 rounded-xl font-mono text-xs text-salsa-cyan border border-salsa-border">
            <code>ve baja chuspa://prod-chuspa-name/test/file.txt .</code>
          </div>
        </div>

        <!-- Command 3: Make Bucket -->
        <div class="bg-salsa-card border border-salsa-border p-6 rounded-3xl hover:border-salsa-lime transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono bg-salsa-lime/10 text-salsa-lime px-3 py-1 rounded-lg font-bold">MB / Create Bucket</span>
            <i data-lucide="folder-plus" class="w-5 h-5 text-salsa-lime"></i>
          </div>
          <h3 class="text-xl font-black text-white mb-2">ve crea</h3>
          <p class="text-slate-400 text-xs mb-4">Abre una chuspa completamente nueva lista para recibir datos.</p>
          <div class="bg-salsa-dark p-3 rounded-xl font-mono text-xs text-salsa-lime border border-salsa-border">
            <code>ve crea chuspa://mi-nueva-chuspa</code>
          </div>
        </div>

        <!-- Command 4: List Buckets/Objects -->
        <div class="bg-salsa-card border border-salsa-border p-6 rounded-3xl hover:border-salsa-pink transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono bg-salsa-pink/10 text-salsa-pink px-3 py-1 rounded-lg font-bold">LS / List</span>
            <i data-lucide="list" class="w-5 h-5 text-salsa-pink"></i>
          </div>
          <h3 class="text-xl font-black text-white mb-2">ve mira</h3>
          <p class="text-slate-400 text-xs mb-4">Listá todas las chuspas disponibles o el contenido dentro de una.</p>
          <div class="bg-salsa-dark p-3 rounded-xl font-mono text-xs text-salsa-pink border border-salsa-border">
            <code>ve mira chuspa://prod-chuspa-name/</code>
          </div>
        </div>

        <!-- Command 5: Delete -->
        <div class="bg-salsa-card border border-salsa-border p-6 rounded-3xl hover:border-red-400 transition-all">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono bg-red-500/10 text-red-400 px-3 py-1 rounded-lg font-bold">RM / Delete</span>
            <i data-lucide="trash-2" class="w-5 h-5 text-red-400"></i>
          </div>
