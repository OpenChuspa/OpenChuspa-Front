  function switchSdkTab(key: string) {
    document.querySelectorAll('.sdk-tab').forEach((b) => {
      (b as HTMLElement).className =
        'sdk-tab bg-salsa-card hover:bg-salsa-border text-slate-300 px-5 py-2.5 rounded-xl font-mono text-xs font-bold transition-all';
    });
    const activeBtn = $(`tab-${key}`);
    if (activeBtn)
      activeBtn.className =
        'sdk-tab bg-salsa-orange text-white px-5 py-2.5 rounded-xl font-mono text-xs font-bold transition-all';

    const title = $('sdk-title');
    const block = $('sdk-code-block');
    if (title) title.innerText = sdkSnippets[key].title;
    if (block) block.innerText = sdkSnippets[key].code;
  }

  // ====== Clipboard + Toast ======
  async function copyText(str: string) {
    try {
      await navigator.clipboard.writeText(str);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = str;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }
    showToast('¡Copiado al portapapeles, mi llave! 🚀');
  }

  let toastTimer: number | undefined;
  function showToast(msg: string) {
    const toast = $('toast');
    const toastMsg = $('toast-msg');
    if (!toast || !toastMsg) return;
    toastMsg.innerText = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 3000);
  }

  // ====== Wire up events ======
  function init() {
    renderBuckets();
    generateCustomCommand();

    // Terminal form
    const form = $('terminal-form') as HTMLFormElement | null;
    const input = $('terminal-input') as HTMLInputElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const cmd = input?.value.trim();
      if (cmd) {
        runCommand(cmd);
        if (input) input.value = '';
      }
    });

    // Quick command buttons
    document.querySelectorAll<HTMLElement>('.js-run-cmd').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.dataset.cmd;
        if (cmd) runCommand(cmd);
      });
    });

    // Generator inputs
    $('gen-action')?.addEventListener('change', generateCustomCommand);
    $('gen-file')?.addEventListener('input', generateCustomCommand);
    $('gen-chuspa')?.addEventListener('input', generateCustomCommand);
    $('gen-copy-btn')?.addEventListener('click', () => {
      const out = $('gen-output');
      if (out) copyText(out.innerText);
    });

    // SDK tabs
    document.querySelectorAll<HTMLElement>('.sdk-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sdk;
        if (key) switchSdkTab(key);
      });
    });
    $('sdk-copy-btn')?.addEventListener('click', () => {
      const block = $('sdk-code-block');
      if (block) copyText(block.innerText);
    });

    // Generic copy buttons
    document.querySelectorAll<HTMLElement>('.js-copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.copy;
        if (text) copyText(text);
      });
    });

    // Reproductor de salsa
    setupSalsaPlayer();
  }

  // ====== Reproductor de salsa (Yo Soy Cali Salsa, stream en vivo) ======
  const SALSA_STREAM = 'https://stream.integracionvirtual.com/proxy/yosoycalisalsa?mp=/stream';

  function setupSalsaPlayer() {
    const audio = $('salsa-audio') as HTMLAudioElement | null;
    const toggle = $('salsa-toggle');
    const icon = $('salsa-icon');
    const label = $('salsa-label');
    const eq = $('salsa-eq');
    const vol = $('salsa-vol') as HTMLInputElement | null;
    if (!audio || !toggle) return;

    audio.volume = vol ? parseFloat(vol.value) : 0.6;

    const setPlayingUI = (playing: boolean) => {
      if (label) label.textContent = playing ? 'Sonando salsa' : 'Poné salsa 🎺';
      if (eq) eq.classList.toggle('is-playing', playing);
      if (icon) {
        icon.setAttribute('data-lucide', playing ? 'pause' : 'play');
        // @ts-ignore - re-render de iconos lucide
        window.lucide?.createIcons?.();
      }
    };

    const play = async () => {
      // Cache-buster para evitar que el navegador sirva un buffer viejo del stream
      if (!audio.src) audio.src = `${SALSA_STREAM}&_t=${Date.now()}`;
      try {
        await audio.play();
      } catch {
        // Autoplay bloqueado: quedará listo para el primer gesto del usuario
      }
    };

    toggle.addEventListener('click', () => {
      if (audio.paused) play();
      else audio.pause();
    });

    audio.addEventListener('playing', () => setPlayingUI(true));
    audio.addEventListener('pause', () => setPlayingUI(false));
    audio.addEventListener('ended', () => setPlayingUI(false));

    vol?.addEventListener('input', () => {
      audio.volume = parseFloat(vol.value);
    });

    // Intento de autoplay al entrar; si el navegador lo bloquea,
    // arranca con el primer gesto (click / tecla / scroll / touch).
    play();
    const kickstart = () => {
      if (audio.paused) play();
    };
    const once = { once: true } as AddEventListenerOptions;
    window.addEventListener('pointerdown', kickstart, once);
    window.addEventListener('keydown', kickstart, once);
    window.addEventListener('touchstart', kickstart, once);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
